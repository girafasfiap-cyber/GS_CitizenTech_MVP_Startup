# Copie para .env (local). No Azure, use App Service > Configuration > Application settings. NUNCA faça commit de segredos.
ADMIN_KEY=troque-por-uma-chave-longa-e-aleatoria
# Opcional: sem a chave, a triagem usa regras (modelo "regras-v1")
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Opcional: liga a telemetria no Azure Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Opcional: caminho do Data Warehouse SQLite do pipeline de Big Data (alimenta o painel de demanda SP156)
DW_PATH=
DATA_DIR=data
